JWT_SECRET=change-me-min-32-chars
MONGO_URI=mongodb://127.0.0.1:27017/hizmet_pazari
# Birden fazla frontend origin icin virgulle ayirin.
CORS_ORIGIN=http://localhost:5173,https://hizmet-pazari-projesi.vercel.app
FRONTEND_URL=http://localhost:5173

# Brevo API kullanimi onerilir. BREVO_API_KEY varsa SMTP fallback'e girilmez.
BREVO_API_KEY=your-brevo-api-key

# Brevo SMTP fallback
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=2525
BREVO_SMTP_USER=your-brevo-smtp-login
BREVO_SMTP_KEY=your-brevo-smtp-key
BREVO_FROM_EMAIL=no-reply@your-domain.com
BREVO_FROM_NAME=Hizmet Pazari

ADMIN_EMAIL=admin@example.com
