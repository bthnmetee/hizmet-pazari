JWT_SECRET=change-me-min-32-chars
MONGO_URI=mongodb://127.0.0.1:27017/hizmet_pazari
# Birden fazla frontend origin icin virgulle ayirin.
CORS_ORIGIN=http://localhost:5173,https://hizmet-pazari-projesi.vercel.app
FRONTEND_URL=http://localhost:5173

# Cloudinary dosya yukleme
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Mailjet (SMTP)
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-mailjet-api-key
SMTP_PASS=your-mailjet-secret-key
MAIL_FROM_EMAIL=no-reply@your-domain.com
MAIL_FROM_NAME=Hizmet Pazari

ADMIN_EMAIL=admin@example.com
